# =============================================================================
# IRAJ Task Manager — environment variables
# All keys understood by server/config.ts. Secrets stay empty in git.
# Client-only build-time keys are prefixed VITE_ (see bottom).
# =============================================================================

# --- Security (required in production) ---
# SECRET_KEY: JWT signing secret. Required when NODE_ENV=production.
SECRET_KEY=""

# TOKEN_ENCRYPTION_KEY: AES-256-GCM key for Git PATs at rest.
# Required in production and MUST differ from SECRET_KEY.
TOKEN_ENCRYPTION_KEY=""

# --- HTTP ---
# APP_URL: Public origin (OAuth callbacks, password-reset links). Required in production.
APP_URL="http://localhost:3000"
HOST="0.0.0.0"
PORT="3000"
# HOST_NAME: Fallback hostname when APP_URL is unset in production URL resolution.
# HOST_NAME="app.internal"
# HTTP_TRUST_PROXY="1"
# JSON_BODY_LIMIT="10mb"
# HTTP_SHUTDOWN_TIMEOUT_MS="10000"
# HTTP_DEFAULT_DEV_ORIGIN="localhost:3000"

# --- Database ---
# DATABASE_URL: PostgreSQL connection string. When set to a real postgres URL,
# the app uses Postgres and refuses to start if unreachable (no SQLite fallback).
DATABASE_URL=""
# SQLITE_PATH="./data/database.sqlite"
# SQLITE_BUSY_TIMEOUT_MS="5000"
# PG_CONNECTION_TIMEOUT_MS="5000"
# DB_PURGE_UNVERIFIED_INTERVAL_MS="3600000"
# DB_PURGE_UNVERIFIED_AFTER_MS="86400000"

# Local Docker Postgres (used by docker-compose.yaml)
POSTGRES_USER="devuser"
POSTGRES_PASSWORD="devpassword"
POSTGRES_DB="devdb"

# --- Registration & OAuth ---
# ALLOW_PUBLIC_REGISTER: Allow sign-up after the bootstrap super_admin. Default false.
ALLOW_PUBLIC_REGISTER="false"
# OAUTH_AUTO_PROVISION: Create developer accounts from OAuth. Default false.
OAUTH_AUTO_PROVISION="false"
# OAUTH_ALLOWED_DOMAINS: Comma-separated domains when auto-provision is on.
OAUTH_ALLOWED_DOMAINS=""
# OAUTH_STATE_TTL_MS="900000"
# OAUTH_NONCE_PURGE_INTERVAL_MS="600000"
# OAUTH_NONCE_RETENTION_MS="1200000"
# OAUTH_ERROR_PAGE_CLOSE_DELAY_MS="5000"

# --- Auth cookies & JWT ---
# AUTH_COOKIE_NAME="auth_token"
# AUTH_COOKIE_MAX_AGE_MS="604800000"
# AUTH_COOKIE_SAME_SITE="lax"
# AUTH_COOKIE_PATH="/"
# AUTH_COOKIE_HTTP_ONLY="true"
# AUTH_COOKIE_SECURE: Defaults to true in production.
# AUTH_COOKIE_SECURE="false"
# JWT_EXPIRES_IN="7d"
# BCRYPT_ROUNDS="10"
# PASSWORD_MIN_LENGTH="8"
# PASSWORD_RESET_TTL_MS="3600000"
# PENDING_REGISTRATION_COOLDOWN_MS="86400000"

# --- Rate limiting ---
# RATE_LIMIT_API_WINDOW_MS="900000"
# RATE_LIMIT_API_MAX="1000"
# RATE_LIMIT_AUTH_WINDOW_MS="3600000"
# RATE_LIMIT_AUTH_MAX="50"
# RATE_LIMIT_AUTH_EXCLUDED_PATHS="/me,/callback,/callback/,/url"

# --- Security headers ---
# SECURITY_CSP_ENABLED="true"
# SECURITY_CSP_NONCE_BYTES="16"
# SECURITY_COEP_ENABLED="false"

# --- Backup ---
# BACKUP_EXPORT_ENABLED="true"
# BACKUP_RESTORE_ENABLED="true"
# BACKUP_REQUIRE_CONFIRM="true"

# --- Git integration (server) ---
# GIT_ENABLED: Server-side git routes and background PR sync. Default true.
# Client UI toggle is VITE_GIT_ENABLED (build-time).
GIT_ENABLED="true"
# GIT_PR_SYNC_INTERVAL_MS="300000"
# GIT_PR_SYNC_INITIAL_DELAY_MS="5000"
# GIT_PROJECT_ACTIVITY_LIMIT="50"
# GIT_API_FETCH_TIMEOUT_MS="8000"
# GIT_API_MAX_PAGES="10"
# GIT_API_PER_PAGE="100"

# --- OAuth provider credentials ---
GITLAB_URL="https://gitlab.com"
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Mail (optional; required in production for password-reset email) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"

# --- Logging ---
# LOG_LEVEL="info"
# MORGAN_FORMAT="combined"

# --- Optional integrations ---
GEMINI_API_KEY=""

# --- Client build-time (Vite; not read by server config) ---
VITE_APP_NAME="IRAJ Task Manager"
VITE_APP_VERSION="1.0.0"
VITE_GIT_ENABLED="true"
VITE_API_URL="/api"
