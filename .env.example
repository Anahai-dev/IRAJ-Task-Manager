# SECRET_KEY: Secret string used to sign and verify JWT authentication tokens.
# Required in production. Never commit a real value.
SECRET_KEY=""

# TOKEN_ENCRYPTION_KEY: Secret used to encrypt Git PATs at rest (AES-256-GCM).
# Required in production and MUST be distinct from SECRET_KEY.
TOKEN_ENCRYPTION_KEY=""

# APP_URL: Public origin of this app (OAuth callbacks, password-reset links).
# Required in production, e.g. https://tasks.example.com
APP_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL connection string. If set to a real postgres URL,
# the app uses Postgres and will refuse to start if it is unreachable.
# Omit (or leave the placeholder) to use local SQLite at ./database.sqlite
# (or SQLITE_PATH).
DATABASE_URL=""

# SQLITE_PATH: Optional override for the SQLite file in development.
# SQLITE_PATH="./data/database.sqlite"

# Local Docker Postgres Configuration
POSTGRES_USER="devuser"
POSTGRES_PASSWORD="devpassword"
POSTGRES_DB="devdb"

# Tenancy
# Public local registration after the first (bootstrap) user. Default false.
ALLOW_PUBLIC_REGISTER="false"
# If true, OAuth can create developer accounts. Default false — existing users
# can still log in; new OAuth users need admin provisioning.
OAUTH_AUTO_PROVISION="false"
# Optional comma-separated email domains allowed when OAUTH_AUTO_PROVISION=true
OAUTH_ALLOWED_DOMAINS=""

# Application Settings
HOST="0.0.0.0"
PORT="3000"
VITE_APP_NAME="IRAJ Task Manager"
VITE_APP_VERSION="1.0.0"
VITE_GIT_ENABLED="true"

# GitLab OAuth Integration
GITLAB_URL="https://gitlab.com"
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""

# Google OAuth Integration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth Integration
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# API Settings
VITE_API_URL="/api"

# SMTP Settings for Emails (Optional). Required in production for password reset mail.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"
